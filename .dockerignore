# Git and version control
.git/
.gitignore
.gitattributes

# Git worktrees — each holds a full checkout
.worktrees/

# Claude / editor state
.claude/
.cursor/
.vscode/
.idea/

# Infra (not needed for gateway or firecracker-agent builds)
infra/

# Per-app: exclude node_modules everywhere, and exclude apps not used by
# Go image builds. apps/admin/dist is kept because Dockerfile.prebuilt
# needs it. apps/admin/src + public stay in the context because
# Dockerfile.full builds the UI from source; Dockerfile.prebuilt simply
# doesn't COPY them, so the extra context size is harmless.
apps/*/node_modules/
apps/landing/
apps/docs/
apps/admin/node_modules/
services/*/node_modules/
services/*/dist/
packages/*/node_modules/
packages/*/dist/

# Python/tooling caches
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyc

# Other heavy dirs not needed in Go/agent builds
test-evals/
tmp/
qdrant_storage/
browser-streamer/
bin/
# ui/ is a Go package (embeds prebuilt UI via go:embed) — do NOT exclude
# stray top-level binary from local go build
/firecracker-agent


# Documentation
*.md
docs/
TODO.md

# Development files
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts
bin/
tmp/
.artifacts/
build/*
!build/Dockerfile.runtime
!build/install-go-tools.sh
!build/run-with-retry.sh
dist/*
!dist/everstack-linux-*
!dist/everstack-services-linux-*
!dist/SHA256SUMS.txt

# Test files and results
*_test.go
test/
tests/
results/
coverage.out

# Dependencies (will be downloaded in container)
node_modules/
vendor/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
*.suo
*.user
*.userosscache
*.sln.docstates

# Logs
*.log
logs/

# Runtime data
pids/
*.pid
*.seed

# Docker files (except the ones we need)
Dockerfile.*
docker-compose*.yml
docker-start.sh

# Scripts (but keep tools/protogen for builds)
scripts/
tools/
!tools/protogen/

# Examples and config (passed as volumes)
examples/
compare/

# Performance test results
competitive/
high_volume/
ramp/

# Portal/frontend (not needed for backend builds, but apps/ needed for UI embedding)
portal/
# apps/ - commented out to allow UI embedding builds
