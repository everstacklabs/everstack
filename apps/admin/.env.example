# Admin UI Environment Variables
# These are baked into the build at compile time (not runtime)

# API Base URL - The backend server endpoint
# Development: http://localhost:8089
# Production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8089

# Connect Base Path - Optional path prefix for Connect RPC endpoints
# Usually empty or /api/v1
VITE_CONNECT_BASE_PATH=

# API Key - Optional API key for authenticated requests
# Leave empty for development with same-origin requests
VITE_API_KEY=

# PostHog (product analytics + session recordings)
# Leave empty to disable (no events sent). Set in cloud/prod builds only.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

