{
  "name": "@everstack/docs",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --port 3002",
    "prebuild": "node --import tsx/esm scripts/generate-llms.mts",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "generate:llms": "node --import tsx/esm scripts/generate-llms.mts",
    "start": "sh -c \"wrangler deploy --config wrangler.toml --x-autoconfig=false\"",
    "test": "node --import tsx/esm --test src/lib/layout.shared.test.mts",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write",
    "generate:api": "node --import tsx/esm scripts/generate-api-docs.mts",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:preview": "pnpm build && wrangler versions upload"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.90.0",
    "@tanstack/react-router": "1.161.3",
    "@tanstack/react-router-devtools": "1.161.3",
    "@tanstack/react-start": "1.161.3",
    "fumadocs-core": "^16.7.12",
    "fumadocs-mdx": "14.2.6",
    "fumadocs-openapi": "^10.3.6",
    "fumadocs-ui": "^16.7.12",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.12.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shiki": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@tailwindcss/vite": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.4",
    "wrangler": "^4.0.0"
  }
}
