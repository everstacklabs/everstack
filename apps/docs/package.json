{
  "name": "@everstack/docs",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --port 3002",
    "prebuild": "node --import tsx/esm scripts/generate-llms.mts",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "generate:llms": "node --import tsx/esm scripts/generate-llms.mts",
    "start": "sh -c \"wrangler deploy --config wrangler.toml --x-autoconfig=false\"",
    "test": "node --import tsx/esm --test src/lib/*.test.mts",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write",
    "generate:api": "node --import tsx/esm scripts/generate-api-docs.mts",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:preview": "pnpm build && wrangler versions upload"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.102.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "fumadocs-core": "^16.18.0",
    "fumadocs-mdx": "15.5.0",
    "fumadocs-openapi": "^12.6.0",
    "fumadocs-ui": "^16.18.0",
    "lucide-react": "^1.69.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.0.4",
    "wrangler": "^4.158.0"
  }
}
