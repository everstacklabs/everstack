            "type": "string",
            "title": "WorkOS connection ID for enterprise SSO"
          },
          "redirectUri": {
            "type": "string",
            "title": "Where to redirect after auth"
          },
          "state": {
            "type": "string",
            "title": "State to preserve through OAuth flow (e.g., return URL)"
          }
        },
        "title": "GetAuthURLRequest - Get SSO auth URL for sign-in redirect"
