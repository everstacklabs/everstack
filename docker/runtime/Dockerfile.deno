# Runtime image for Deno isolated function execution
# Build: docker build -t ghcr.io/everstacklabs/runtime:deno -f Dockerfile.deno .

FROM --platform=linux/amd64 denoland/deno:alpine-1.40.2

# Install security updates
RUN apk upgrade --no-cache

# Create non-root user
RUN adduser -D -s /bin/sh runner
WORKDIR /app

# Copy runner script
COPY runner-deno.ts /app/runner.ts

# Pre-cache common dependencies
RUN deno cache \
    https://deno.land/std@0.212.0/http/mod.ts \
    https://deno.land/std@0.212.0/uuid/mod.ts \
    https://deno.land/std@0.212.0/datetime/mod.ts \
    https://deno.land/std@0.212.0/encoding/base64.ts

# Set environment
ENV DENO_DIR=/tmp/deno

# Switch to non-root user
USER runner

# Runner receives payload as first argument
ENTRYPOINT ["deno", "run", "--allow-read=/tmp", "--allow-write=/tmp", "--allow-env", "/app/runner.ts"]
