# Runtime image for Node.js 20 isolated function execution
# Build: docker build -t ghcr.io/everstacklabs/runtime:nodejs20 -f Dockerfile.nodejs20 .

FROM node:20-alpine

# Install security updates
RUN apk upgrade --no-cache

# Create non-root user
RUN adduser -D -s /bin/sh runner
WORKDIR /app

# Copy runner script
COPY runner-node.js /app/runner.js

# Pre-install common packages for faster cold starts
RUN npm install -g \
    lodash@4.17.21 \
    axios@1.6.7 \
    uuid@9.0.1 \
    dayjs@1.11.10 \
    zod@3.22.4 \
    && npm cache clean --force

# Set environment
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=512"

# Switch to non-root user
USER runner

# Runner receives payload as first argument
ENTRYPOINT ["node", "/app/runner.js"]
