EVERSTACK_GATEWAY_URL=https://your-everstack-instance.example.com
EVERSTACK_API_KEY=sk_replace_me

# Optional. When omitted, the example discovers a chat model from the instance.
# EVERSTACK_MODEL=gpt-5.6
# EVERSTACK_PROVIDER=@openai

# Optional override. The SDK normally resolves the organization from the key.
# EVERSTACK_ORG_ID=org_replace_me
# EVERSTACK_USER_ID=user_replace_me

# The default runs a deterministic 2 vCPU, 2 GiB sandbox qualification suite.
# Generated code remains isolated, offline, and resource bounded.
# EVERSTACK_SANDBOX_IMAGE=ghcr.io/everstacklabs/sandbox:node
# Set a prompt only to replace the qualification suite with a custom workload.
# EVERSTACK_PROMPT=Run a custom JavaScript workload and report its result.
# TRACE_WAIT_MS=30000
# KEEP_RESOURCES=false
