# Shared config for all SDK smoke tests (node, python, go).
# Copy to .env in this directory; each language test loads it.

# Base URL of the Everstack gateway (no trailing slash), e.g. https://gateway.example.com
EVERSTACK_GATEWAY_URL=

# Everstack API key (pk_...)
EVERSTACK_API_KEY=

# Optional: pin a specific model instead of auto-discovering one from the gateway.
# Accepts a bare id (e.g. gpt-4o-mini) or @provider/model (e.g. @openai/gpt-4o-mini).
# EVERSTACK_TEST_MODEL=
