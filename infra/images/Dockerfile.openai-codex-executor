# Reproducible OpenAI Agents API self-hosted executor image.
# Build locally:
#   docker build --platform linux/amd64 \
#     -f infra/images/Dockerfile.openai-codex-executor \
#     -t everstack/openai-codex-executor:0.154.0 .
FROM docker.io/library/node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5

ARG CODEX_VERSION=0.154.0
ARG CODEX_INTEGRITY=sha512-FV/x1OHXYv/ifjf3mXj9ThTTAWcUZN6cGIRQRhRxkKNOPuImu1WW0c8ev1vUkE9XGH90dEnYG1tBjIkxRikg0w==

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global --ignore-scripts=false --include=optional \
      --integrity="${CODEX_INTEGRITY}" "@openai/codex@${CODEX_VERSION}" \
    && test "$(codex --version)" = "codex-cli ${CODEX_VERSION}" \
    && codex exec-server --help >/dev/null

RUN useradd --create-home --home-dir /workspace --shell /bin/sh sandbox \
    && chown sandbox:sandbox /workspace

USER sandbox
WORKDIR /workspace

LABEL org.opencontainers.image.title="Everstack OpenAI Agents API executor" \
      org.opencontainers.image.source="https://github.com/everstacklabs/platform" \
      dev.everstack.openai-codex.version="0.154.0" \
      dev.everstack.openai-codex.npm-integrity="sha512-FV/x1OHXYv/ifjf3mXj9ThTTAWcUZN6cGIRQRhRxkKNOPuImu1WW0c8ev1vUkE9XGH90dEnYG1tBjIkxRikg0w=="

CMD ["sleep", "infinity"]
