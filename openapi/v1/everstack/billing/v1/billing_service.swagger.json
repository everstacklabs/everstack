    "v1AdjustSeatsResponse": {
      "type": "object",
      "properties": {
        "paidSeats": {
          "type": "integer",
          "format": "int32",
          "description": "Total paid seats after adjustment. Effective cap on the org is\nplan.seat_limit + paid_seats (auth service reads paid_seats from\nthe local cache so this value matches what InviteMember will see\nimmediately after)."
        },
        "unitPriceCents": {
          "type": "string",
          "format": "int64",
          "description": "Per-seat unit price in cents (e.g. 1500 = \\$15.00). Frontend uses\nthis for \"Charged \\$X today, prorated\" copy."
        },
        "currency": {
          "type": "string",
          "description": "ISO 4217 currency code (e.g. \"usd\")."
        }
