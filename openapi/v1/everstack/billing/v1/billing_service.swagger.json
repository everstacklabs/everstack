          "type": "string",
          "format": "int64",
          "description": "Sandbox network data transfer this period (bytes)."
        },
        "networkTxBytes": {
          "type": "string",
          "format": "int64"
        },
        "sandboxComputeSeconds": {
          "type": "string",
          "format": "int64",
          "description": "Sandbox compute charged in this billing period. Compute accrues per\nsecond while the VM is allocated, including idle time; sleeping and\nstopped sandboxes do not accrue compute."
        },
        "sandboxComputeCostMicros": {
          "type": "string",
          "format": "int64"
        },
        "browserRuntimeSeconds": {
          "type": "string",
          "format": "int64",
          "description": "Hosted-browser time charged in this billing period. Idle pool capacity is\nexcluded; the one-minute minimum and per-second increments are finalized\nby the browser serving plane before this cumulative meter is reported."
        },
        "browserRuntimeCostMicros": {
          "type": "string",
          "format": "int64"
        },
        "sandboxStarterCreditMicros": {
          "type": "string",
          "format": "int64",
          "description": "One-time organization starter credit for managed sandbox compute. These\nvalues are lifetime scoped and do not reset with the billing period."
        },
