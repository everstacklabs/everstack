          "type": "string",
          "format": "date-time"
        },
        "windowEnd": {
          "type": "string",
          "format": "date-time"
        },
        "bucketSeconds": {
          "type": "string",
          "format": "int64",
          "description": "Bucket width. Buckets are sparse (only non-empty (start, instance)\npairs); bucket starts are UTC multiples of bucket_seconds, the first one\nat or before window_start. Clients fill the gaps with zeros."
        },
        "buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1OrgActivityBucket"
          }
        },
        "current": {
          "$ref": "#/definitions/v1OrgActivityTotals"
        },
        "previous": {
          "$ref": "#/definitions/v1OrgActivityTotals"
        },
        "previousAvailable": {
          "type": "boolean",
          "description": "False when the previous window reaches past raw telemetry retention, so\na delta would compare against data that has already expired."
        },
        "requestsDelta": {
          "$ref": "#/definitions/v1OrgActivityDelta"
        },
        "tokensDelta": {
          "$ref": "#/definitions/v1OrgActivityDelta"
        },
        "errorRateDelta": {
          "$ref": "#/definitions/v1OrgActivityDelta"
        },
        "p95LatencyDelta": {
          "$ref": "#/definitions/v1OrgActivityDelta"
        },
        "topModels": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1OrgActivityModel"
          },
          "title": "by requests, at most 5"
        },
        "available": {
          "type": "boolean",
          "description": "False when this deployment has no telemetry store; every number is then\nzero because it was not measured, not because nothing happened."
        },
        "latencyBuckets": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1OrgActivityLatencyBucket"
          },
          "description": "Per-bucket p95 over the current window, same bucket starts as buckets.\nSparse: a bucket with no timed calls is absent."
        }
      }
    },
