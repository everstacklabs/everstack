    "v1OrgActivityBucket": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "instanceId": {
          "type": "string",
          "title": "mapped to a name client-side, never displayed"
        },
        "requests": {
          "type": "string",
          "format": "int64"
        },
        "tokens": {
          "type": "string",
          "format": "int64"
        },
        "errors": {
          "type": "string",
          "format": "int64"
        }
      },
      "description": "One model call is one generation span: a provider call made by the\ngateway (each retry or fallback attempt counts), or an LLM span the\ncustomer's app sent over OTLP. An app span whose trace also holds a\ngateway generation span is the same call seen twice and is not counted."
    },
    "v1OrgActivityDelta": {
      "type": "object",
      "properties": {
        "hasValue": {
          "type": "boolean"
        },
        "change": {
          "type": "number",
          "format": "double",
          "description": "Relative change (0.12 = +12%) for requests, tokens and p95; for the\nerror rate it is the difference of the two rates (0.004 = +0.4 points)."
        }
      },
      "description": "Change versus the previous equal-length window. has_value is false when\nthe previous window is not available or its value is zero."
    },
    "v1OrgActivityLatencyBucket": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "p95LatencyMs": {
          "type": "number",
          "format": "double"
        },
        "samples": {
          "type": "string",
          "format": "int64"
        }
      },
      "description": "p95 latency of one bucket across all of the org's instances (quantiles\ndo not add up across instances, so this is not per instance). Only\nbuckets with at least one timed call are sent."
    },
