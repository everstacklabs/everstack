    "v1InstanceStatus": {
      "type": "string",
      "enum": [
        "INSTANCE_STATUS_UNSPECIFIED",
        "INSTANCE_STATUS_PROVISIONING",
        "INSTANCE_STATUS_STARTING",
        "INSTANCE_STATUS_RUNNING",
        "INSTANCE_STATUS_STOPPING",
        "INSTANCE_STATUS_STOPPED",
        "INSTANCE_STATUS_DEGRADED",
        "INSTANCE_STATUS_FAILED",
        "INSTANCE_STATUS_DELETING",
        "INSTANCE_STATUS_PAUSED"
