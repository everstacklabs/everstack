        }
      }
    },
    "v1RestoreResponse": {
      "type": "object",
      "properties": {
        "exitCode": {
          "type": "integer",
          "format": "int32"
        },
        "stderr": {
          "type": "string"
        },
        "bytesReceived": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1SandboxConfig": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "cpuLimit": {
          "type": "number",
          "format": "double"
        },
        "memoryMb": {
          "type": "string",
          "format": "int64"
        },
        "diskMb": {
          "type": "string",
          "format": "int64"
        },
        "timeoutSeconds": {
          "type": "integer",
          "format": "int32"
        },
        "networkMode": {
          "type": "string",
          "title": "\"deny\", \"whitelist\", \"allow\""
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "envVars": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "workDir": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "dnsServers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "agentId": {
          "type": "string"
        },
        "sshEnabled": {
          "type": "boolean"
        }
      }
    },
    "v1SandboxInstance": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "containerId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "title": "\"pending\", \"running\", \"stopped\", \"failed\""
        },
        "backend": {
          "type": "string"
        },
        "createdAtUnix": {
          "type": "string",
          "format": "int64"
        },
        "expiresAtUnix": {
          "type": "string",
          "format": "int64"
        },
        "nodeName": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "agentHealthy": {
          "type": "boolean",
          "description": "agent_healthy reflects the in-guest agent's HTTP /health probe\nresult at the time this response was assembled. true means the\nhost-side HealthMonitor saw a 204 on its most recent tick (default\nevery 20s). false means the agent has stopped answering. Distinct\nfrom `status` above, which tracks the VM's lifecycle (\"running\",\n\"stopped\") and doesn't observe in-guest liveness.\n\nFor backends that don't run an in-guest agent (Docker, Kubernetes,\nDeny-mode Firecracker) the field is always true — those code paths\nhave their own health stories that don't map onto this signal."
        }
      }
    },
    "v1SandboxStats": {
      "type": "object",
      "properties": {
        "cpuPercent": {
          "type": "number",
          "format": "double"
        },
        "memoryUsage": {
          "type": "string",
          "format": "int64"
        },
        "memoryLimit": {
          "type": "string",
          "format": "int64"
        },
        "memoryPercent": {
          "type": "number",
          "format": "double"
        },
        "networkRxBytes": {
          "type": "string",
          "format": "int64"
        },
        "networkTxBytes": {
          "type": "string",
          "format": "int64"
        },
        "blockRead": {
          "type": "string",
          "format": "int64"
        },
        "blockWrite": {
          "type": "string",
          "format": "int64"
        },
        "pids": {
          "type": "integer",
          "format": "int32"
        },
        "timestampUnix": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1SessionInfo": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "attachedClients": {
          "type": "integer",
          "format": "int64",
          "description": "Number of clients currently attached. \u003e1 means multiple browsers\nor an SSH client + UI client are sharing the session."
        },
        "createdUnix": {
          "type": "string",
          "format": "int64",
          "description": "Session creation time as a Unix timestamp."
        },
        "lastActivityUnix": {
          "type": "string",
          "format": "int64",
          "description": "tmux's record of the last time any pane in the session received\ninput or wrote output. Zero means \"guest tmux didn't report a\nvalue\" — the reaper treats that as unknown and leaves the\nsession alone (fail-safe)."
        }
      }
    },
    "v1ShellClose": {
      "type": "object"
    },
    "v1ShellExit": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "error": {
          "type": "string"
        },
        "sessionTerminated": {
          "type": "boolean",
          "description": "SessionTerminated is true when the underlying persistent session\nis gone (e.g. session_kill, shell exited cleanly, VM rebooted).\nWhen false, the client can retry-attach with the same session_id\nand land back in the same shell. When true, the client should\nsurface \"your session ended\" and start fresh."
        }
      }
    },
    "v1ShellInit": {
      "type": "object",
      "properties": {
        "sandboxId": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sessionId": {
          "type": "string",
          "description": "SessionID reattaches to an existing persistent shell session.\nEmpty creates a new session and the server sends the assigned ID\nback in the first ShellServerMessage. Clients should remember the\nID across reconnects so a brief network drop or fcagent restart\ndoesn't lose the user's working shell. An unknown SessionID is a\nhard error (returned as ShellExit with session_terminated=true and\nan \"session_gone\" error string) so the host never silently swaps\nin a fresh shell when the user thought they were resuming."
        }
      }
    },
    "v1ShellResize": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "integer",
          "format": "int64"
        },
        "cols": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "v1ShellServerMessage": {
      "type": "object",
      "properties": {
        "stdout": {
          "$ref": "#/definitions/v1ShellStdout"
        },
        "exit": {
          "$ref": "#/definitions/v1ShellExit"
        },
        "session": {
          "$ref": "#/definitions/v1ShellSession",
          "description": "ShellSession is sent as the first server message on a new\nshell stream so the client knows which session_id it landed\non. Empty on reattach (the client already knows). Optional —\nolder clients that ignore it still work, they just can't\nreconnect."
        }
      }
    },
    "v1ShellSession": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Server-assigned session ID. Stable across attach/detach cycles."
        },
        "reattached": {
          "type": "boolean",
          "description": "True when this stream attached to a pre-existing session (rather\nthan created a fresh one). Informational only."
        },
        "transport": {
          "type": "string",
          "description": "Host↔guest transport actually used for this shell (\"vsock\" or \"ws\").\nSet by the Firecracker backend based on selectShellTransport. Empty\nfor non-FC backends or older fcagent versions that pre-date the\nPhase 5b flag. UI surfaces this in the Shell tab so operators\nrolling out the new transport can see at a glance which path\neach session landed on."
        }
      }
    },
    "v1ShellStdin": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "format": "byte"
        }
      }
    },
    "v1ShellStdout": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "format": "byte"
        }
      }
    },
    "v1SnapshotChunk": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "format": "byte"
        }
      }
    }
  }
