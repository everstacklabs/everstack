          }
        }
      }
    },
    "v1ListSandboxesResponse": {
      "type": "object",
      "properties": {
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1SandboxInstance"
          }
        }
      }
    },
    "v1ListSessionsResponse": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1SessionInfo"
          }
        },
        "nowUnix": {
          "type": "string",
          "format": "int64",
          "description": "NowUnix is the guest's wall-clock time at the moment the agent\nassembled this response. Pair with each session's\nlast_activity_unix to compute idle duration in guest-clock terms\n— avoids host/guest clock-drift bugs that accumulate on\nlong-running Firecracker VMs."
        }
      }
    },
    "v1LogChunk": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "format": "byte"
        }
      }
    },
    "v1NodeHealth": {
      "type": "object",
      "properties": {
        "healthy": {
          "type": "boolean",
          "description": "Computed bool — true means safe to schedule new sandboxes here.\nWhen false, `reason` explains which threshold tripped."
        },
        "reason": {
          "type": "string"
        },
        "diskPct": {
          "type": "number",
          "format": "double",
          "description": "Pressure percentages (0..100). disk is the workdir filesystem\n(where rootfs overlays land); mem is /proc/meminfo Available\nagainst Total; cpu is the 1-minute load average normalized by\nlogical CPUs; fd is open FDs against the soft rlimit."
        },
        "memPct": {
          "type": "number",
          "format": "double"
        },
        "cpuPct": {
          "type": "number",
          "format": "double"
        },
        "fdPct": {
          "type": "number",
          "format": "double"
        },
        "vmCount": {
          "type": "integer",
          "format": "int32",
          "description": "Current VM count and configured maximum on this node. The\nscheduler may also choose to weight by remaining capacity."
        },
        "vmMax": {
          "type": "integer",
          "format": "int32"
        },
        "timestampUnix": {
          "type": "string",
          "format": "int64",
          "description": "Wall-clock timestamp the snapshot was taken. The cache uses this\nto age stale entries; \u003e30s old → re-probe before trusting."
        }
      },
      "description": "NodeHealth is the host's self-reported pressure signal. Returned by\nGetNodeHealth; cached by the gateway-side LoadBalancer and consulted\nbefore every sandbox placement. healthy=false → skip this node for\nnew creates until the next refresh.\n\nThresholds are evaluated host-side so the load balancer doesn't have\nto know the policy — that keeps the gateway thin and lets per-host\noverrides (e.g. tighter disk limits on small nodes) live with the\nnode config."
    },
    "v1NodeInfoResponse": {
      "type": "object",
      "properties": {
        "nodeName": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "warmVms": {
          "type": "integer",
          "format": "int32"
        },
        "activeVms": {
          "type": "integer",
          "format": "int32"
        },
        "maxTotal": {
          "type": "integer",
          "format": "int32"
        },
        "timestampUnix": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1ReadFileResponse": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "format": "byte"
        },
        "size": {
          "type": "string",
