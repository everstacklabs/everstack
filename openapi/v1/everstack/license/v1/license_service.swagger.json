        "licenseJwt": {
          "type": "string",
          "title": "Ed25519-signed JWT containing license state"
        },
        "licensePublicKey": {
          "type": "string",
          "title": "Base64-encoded Ed25519 public key for JWT verification"
        }
      },
      "title": "Activation response with instance binding and refresh token"
    },
    "v1BillingPeriod": {
      "type": "string",
      "enum": [
        "BILLING_PERIOD_UNSPECIFIED",
        "BILLING_PERIOD_MONTHLY",
        "BILLING_PERIOD_YEARLY"
      ],
      "default": "BILLING_PERIOD_UNSPECIFIED",
      "title": "BillingPeriod represents the billing cycle for a plan"
    },
    "v1CheckActivationTokenStatusResponse": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/definitions/CheckActivationTokenStatusResponseTokenStatus"
