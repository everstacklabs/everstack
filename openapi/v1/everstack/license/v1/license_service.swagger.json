    "v1EnforcementLimits": {
      "type": "object",
      "properties": {
        "dailyRequestLimit": {
          "type": "string",
          "format": "int64",
          "description": "Max requests per day (0 = unlimited)",
          "title": "Request limits"
        },
        "monthlyRequestLimit": {
          "type": "string",
          "format": "int64",
          "title": "Max requests per month (0 = unlimited)"
        },
        "rpmLimit": {
          "type": "string",
          "format": "int64",
          "title": "Max requests per minute (0 = unlimited)"
        },
        "dailyTokenLimit": {
          "type": "string",
          "format": "int64",
          "description": "Max tokens per day (0 = unlimited)",
          "title": "Token limits"
        },
        "monthlyTokenLimit": {
          "type": "string",
          "format": "int64",
          "title": "Max tokens per month (0 = unlimited)"
        },
        "dailySpendLimitCents": {
          "type": "string",
          "format": "int64",
          "description": "Max spend per day (0 = unlimited)",
          "title": "Spend limits (in cents to avoid floating point issues)"
