          "type": "string",
          "format": "int64",
          "description": "Cumulative flow metrics for the current period (since last reset).\nDistinct from the delta fields above (total_requests, total_tokens, etc.\nwhich carry per-report deltas for Stripe metering). These cumulative\nvalues populate usage_totals for the period headline numbers.\nCosts are micro-dollars (USD * 1_000_000)."
        },
        "cumulativeTotalRequests": {
          "type": "string",
          "format": "int64"
        },
        "cumulativeInputTokens": {
          "type": "string",
          "format": "int64"
        },
        "cumulativeOutputTokens": {
          "type": "string",
          "format": "int64"
        },
        "cumulativeCostMicros": {
          "type": "string",
          "format": "int64"
        },
        "cumulativeCacheSavingsMicros": {
          "type": "string",
          "format": "int64"
        },
        "cumulativeCacheHits": {
          "type": "string",
          "format": "int64"
        },
        "cumulativeCacheMisses": {
          "type": "string",
          "format": "int64"
        },
        "cumulativeNetworkRxBytes": {
          "type": "string",
          "format": "int64",
          "description": "Cumulative sandbox network data transfer this period (bytes), summed\nacross the instance's sandboxes from the usage ledger."
        },
        "cumulativeNetworkTxBytes": {
          "type": "string",
          "format": "int64"
        },
        "cumulativeSandboxComputeSeconds": {
          "type": "string",
          "format": "int64",
          "description": "Lifetime-monotonic sandbox compute meters. The billing service keeps a\nper-instance watermark and charges only the positive delta, so retries\nand out-of-order reports cannot double bill. The first observation is a\nnon-billable rollout baseline."
        },
        "cumulativeSandboxComputeCostMicros": {
          "type": "string",
          "format": "int64"
        },
        "concurrentSandboxesCount": {
          "type": "string",
          "format": "int64",
