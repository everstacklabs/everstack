        },
        "cumulativeBrowserRuntimeSeconds": {
          "type": "string",
          "format": "int64",
          "description": "Lifetime-monotonic hosted-browser lease meters. Idle pool pods are not\nincluded. Central billing applies only positive deltas against the same\ndurable per-instance watermark contract used for sandbox compute."
        },
        "cumulativeBrowserRuntimeCostMicros": {
          "type": "string",
          "format": "int64"
        }
