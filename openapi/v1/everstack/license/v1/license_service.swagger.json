  "paths": {},
  "definitions": {
    "CheckActivationTokenStatusResponseTokenStatus": {
      "type": "string",
      "enum": [
        "TOKEN_STATUS_UNSPECIFIED",
        "TOKEN_STATUS_AVAILABLE",
        "TOKEN_STATUS_BOUND",
        "TOKEN_STATUS_EXPIRED",
        "TOKEN_STATUS_INVALID"
      ],
      "default": "TOKEN_STATUS_UNSPECIFIED",
      "description": "- TOKEN_STATUS_AVAILABLE: Token exists and has not been used yet\n - TOKEN_STATUS_BOUND: Token has been activated/bound to an instance\n - TOKEN_STATUS_EXPIRED: Token has expired\n - TOKEN_STATUS_INVALID: Token does not exist or is malformed",
      "title": "TokenStatus indicates the current state of an activation token"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1ActivateInstanceResponse": {
      "type": "object",
      "properties": {
        "instanceId": {
          "type": "string"
        },
        "refreshToken": {
          "type": "string",
          "title": "long-lived token for refresh calls"
        },
        "licenseState": {
          "$ref": "#/definitions/v1LicenseState"
        },
