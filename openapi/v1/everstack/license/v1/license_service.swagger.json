    },
    "v1FeatureFlag": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "v1FeatureRelease": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "Human-readable name"
        },
        "description": {
          "type": "string",
          "title": "Feature description"
        },
        "status": {
          "type": "string",
          "title": "'development', 'beta', 'released', 'deprecated'"
