    "v1SpendLimitAction": {
      "type": "string",
      "enum": [
        "SPEND_LIMIT_ACTION_UNSPECIFIED",
        "SPEND_LIMIT_ACTION_BLOCK",
        "SPEND_LIMIT_ACTION_WARN",
        "SPEND_LIMIT_ACTION_NOTIFY"
