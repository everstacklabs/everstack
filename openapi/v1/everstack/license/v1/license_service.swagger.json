      "default": "SPEND_LIMIT_ACTION_UNSPECIFIED",
      "description": "- SPEND_LIMIT_ACTION_BLOCK: Block further requests\n - SPEND_LIMIT_ACTION_WARN: Log warnings but allow requests\n - SPEND_LIMIT_ACTION_NOTIFY: Send email notification only",
