        },
        "limitAmount": {
          "type": "number",
          "format": "double",
          "title": "The limit that would be exceeded"
        },
        "remainingBudget": {
          "type": "number",
          "format": "double",
          "title": "Remaining budget before limit"
        }
      }
    },
    "v1CreateInstanceResponse": {
      "type": "object",
