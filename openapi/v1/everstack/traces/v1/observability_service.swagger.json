            "$ref": "#/definitions/v1TraceUser"
          }
        },
        "totalCount": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "v1MetricsDashboard": {
      "type": "object",
      "properties": {
        "totalRequests": {
          "type": "string",
          "format": "int64"
        },
        "avgLatencyMs": {
          "type": "number",
          "format": "double"
        },
        "totalCost": {
          "type": "number",
          "format": "double"
        },
        "errorRate": {
          "type": "number",
          "format": "double",
          "title": "0.0-1.0"
        },
        "totalTokens": {
          "type": "string",
          "format": "int64"
        },
        "totalInputTokens": {
          "type": "string",
          "format": "int64"
        },
        "totalOutputTokens": {
          "type": "string",
          "format": "int64"
        },
        "uniqueModels": {
          "type": "integer",
          "format": "int32"
        },
        "uniqueProviders": {
          "type": "integer",
          "format": "int32"
        },
        "totalAgentTurns": {
          "type": "string",
          "format": "int64",
          "description": "Agent-loop metrics, separated from gateway request_count /\navg_latency_ms so a 30s tool loop doesn't skew the user-facing\nchat-completion latency. See migration metrics_split_kinds."
        },
        "avgAgentTurnMs": {
          "type": "number",
          "format": "double"
        },
        "p50LatencyMs": {
          "type": "number",
          "format": "double",
          "description": "Latency percentiles in ms, computed across span durations in window."
        },
        "p95LatencyMs": {
          "type": "number",
          "format": "double"
        },
        "p99LatencyMs": {
          "type": "number",
          "format": "double"
        },
        "totalErrors": {
          "type": "string",
          "format": "int64"
        },
        "ttftP50Ms": {
          "type": "number",
          "format": "double",
          "description": "Streaming TTFT percentiles in ms, computed from root/provider spans that\ncarry llm.stream.time_to_first_token_ms. Zero when no streaming traffic\nmatched the window."
        },
        "ttftP95Ms": {
          "type": "number",
          "format": "double"
        }
      },
      "title": "MetricsDashboard contains top-level KPIs for the observability dashboard"
    },
    "v1MetricsDeltas": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "number",
          "format": "double"
        },
        "errors": {
          "type": "number",
          "format": "double"
        },
        "errorRate": {
          "type": "number",
          "format": "double"
        },
        "cost": {
          "type": "number",
          "format": "double"
        },
        "tokens": {
          "type": "number",
          "format": "double"
        },
        "avgLatency": {
          "type": "number",
          "format": "double"
        },
        "p95Latency": {
          "type": "number",
          "format": "double"
        },
        "ttftP50": {
          "type": "number",
          "format": "double"
        },
        "ttftP95": {
          "type": "number",
          "format": "double"
        }
      },
      "description": "MetricsDeltas contains previous-period percentage deltas. Values are\n(current - previous) / previous, or 0 when the previous value is 0."
    },
    "v1MetricsFilter": {
      "type": "object",
      "properties": {
        "startTime": {
          "type": "string",
          "format": "date-time"
        },
        "endTime": {
          "type": "string",
          "format": "date-time"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "title": "MetricsFilter defines time range and dimension filters for metrics queries"
    },
    "v1MetricsTimeSeries": {
      "type": "object",
      "properties": {
        "buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1TimeSeriesBucket"
          }
        },
        "metricName": {
          "type": "string",
          "title": "e.g., \"request_count\", \"avg_latency_ms\", \"total_cost\""
        }
      },
      "title": "MetricsTimeSeries contains time-bucketed metric data"
    },
    "v1OutcomeDashboard": {
      "type": "object",
      "properties": {
        "taskCompletionRate": {
          "type": "number",
          "format": "double",
          "title": "rate_true(task_completion.finished)"
        },
        "toolSuccessRate": {
          "type": "number",
          "format": "double",
          "title": "avg(tool_quality.success_rate)"
        },
        "policyComplianceRate": {
          "type": "number",
          "format": "double",
          "title": "rate_true(policy.compliant)"
        },
        "loopHealthRate": {
          "type": "number",
          "format": "double",
          "title": "1 - rate_true(loop_health.looping)"
        },
        "iterationEfficiency": {
          "type": "number",
          "format": "double",
          "title": "avg(task_completion.efficiency)"
        },
        "sandboxSuccessRate": {
          "type": "number",
          "format": "double",
          "title": "avg(sandbox_hygiene.exit_code_rate)"
        },
        "totalEvaluations": {
          "type": "string",
          "format": "int64",
          "title": "total score records in window"
        },
        "uniqueSessions": {
          "type": "string",
          "format": "int64",
          "title": "distinct session count"
        }
      },
      "description": "OutcomeDashboard contains aggregated KPIs computed from otel_trace_scores."
    },
    "v1OutcomeScoreSummary": {
      "type": "object",
      "properties": {
        "scoreName": {
          "type": "string"
        },
        "dataType": {
          "type": "string",
          "title": "\"numeric\", \"boolean\", \"categorical\""
        },
        "count": {
          "type": "string",
          "format": "int64"
        },
        "mean": {
          "type": "number",
          "format": "double",
          "title": "avg(NumericValue) or rate_true for boolean"
        },
        "min": {
          "type": "number",
          "format": "double"
        },
        "max": {
          "type": "number",
          "format": "double"
        },
        "p50": {
          "type": "number",
          "format": "double"
        },
        "p95": {
          "type": "number",
          "format": "double"
        },
        "passRate": {
          "type": "number",
          "format": "double",
          "title": "for boolean scores: rate of true"
        }
      },
      "description": "OutcomeScoreSummary provides stats for a single score name."
    },
    "v1TimeSeriesBucket": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "value": {
          "type": "number",
          "format": "double"
        },
        "label": {
          "type": "string",
