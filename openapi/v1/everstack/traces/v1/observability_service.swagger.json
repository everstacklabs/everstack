    "v1ListTraceUsersRequest": {
      "type": "object",
      "properties": {
        "filter": {
          "$ref": "#/definitions/v1MetricsFilter"
        },
        "search": {
          "type": "string",
          "title": "Search user_id"
        },
        "limit": {
          "type": "integer",
          "format": "int32"
        },
        "offset": {
          "type": "integer",
          "format": "int32"
        },
        "orderBy": {
          "type": "string",
          "title": "\"last_seen\", \"trace_count\", \"total_cost\""
        }
