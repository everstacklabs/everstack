    "v1BreakdownRow": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        },
        "requestCount": {
          "type": "string",
          "format": "int64"
        },
        "previousValue": {
          "type": "number",
          "format": "double"
        },
        "provider": {
          "type": "string",
          "description": "Dominant provider for the row, set only for group_by = \"model\" (the\nprovider that served the most requests for this model). Empty otherwise."
        }
      }
    },
    "v1GetMetricsBreakdownRequest": {
      "type": "object",
      "properties": {
        "filter": {
          "$ref": "#/definitions/v1MetricsFilter"
        },
        "metric": {
          "type": "string",
          "title": "\"requests\" | \"errors\" | \"cost\" | \"tokens\""
        },
        "groupBy": {
          "type": "string",
          "description": "\"model\" | \"provider\" | \"environment\" | \"trace_name\".\nFuture extension point: \"prompt_name\". For \"trace_name\", model/provider\nfilters are ignored in v1 because root spans do not always carry those\ndimensions; use trace search for deeper slicing."
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "title": "default 5, max 50"
        },
        "compare": {
          "type": "boolean",
          "title": "populate previous_value from preceding window"
        }
      }
    },
    "v1GetMetricsBreakdownResponse": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1BreakdownRow"
          }
        },
        "totalGroups": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1GetMetricsDashboardRequest": {
      "type": "object",
      "properties": {
        "filter": {
          "$ref": "#/definitions/v1MetricsFilter"
        },
        "compare": {
          "type": "boolean"
        }
      }
    },
    "v1GetMetricsDashboardResponse": {
      "type": "object",
      "properties": {
        "dashboard": {
          "$ref": "#/definitions/v1MetricsDashboard"
        },
        "previous": {
          "$ref": "#/definitions/v1MetricsDashboard"
        },
        "deltas": {
          "$ref": "#/definitions/v1MetricsDeltas"
        }
      }
    },
    "v1GetMetricsTimeSeriesRequest": {
      "type": "object",
      "properties": {
        "filter": {
          "$ref": "#/definitions/v1MetricsFilter"
        },
        "metric": {
          "type": "string",
          "description": "Supported values: \"request_count\", \"error_count\", \"avg_latency_ms\",\n\"total_cost\", \"error_rate\", \"total_tokens\", \"tokens\", \"input_tokens\",\n\"output_tokens\", \"agent_turn_count\", \"avg_agent_turn_ms\", \"ttft_p50\",\n\"ttft_p95\"."
        },
        "groupBy": {
          "type": "string",
          "title": "\"model\", \"provider\", \"\" (no grouping)"
        },
        "granularity": {
          "type": "string",
          "title": "\"hour\", \"6hour\", \"day\"; minute falls back to hourly"
        },
        "compare": {
          "type": "boolean"
        }
      }
    },
    "v1GetMetricsTimeSeriesResponse": {
      "type": "object",
      "properties": {
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1MetricsTimeSeries"
          }
        },
        "previousSeries": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1MetricsTimeSeries"
          },
          "description": "Previous-period data. Buckets keep their original timestamps; clients may\nshift them for visual overlay while retaining true times in tooltips."
        }
      }
    },
    "v1GetOutcomeDashboardRequest": {
      "type": "object",
      "properties": {
        "filter": {
          "$ref": "#/definitions/v1MetricsFilter"
        },
        "agentId": {
          "type": "string",
          "title": "optional: scope to specific agent"
        },
        "groupBy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "group_by accepts: \"model\", \"provider\", \"prompt_template_id\",\n\"prompt_version\", \"tool_name\". Empty list = overall only."
        }
      }
    },
    "v1GetOutcomeDashboardResponse": {
      "type": "object",
      "properties": {
        "dashboard": {
          "$ref": "#/definitions/v1OutcomeDashboard"
        },
        "scores": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1OutcomeScoreSummary"
          }
        },
        "verdictRates": {
          "$ref": "#/definitions/v1VerdictRates",
          "description": "Overall fix_attempt_verdict rates across the filter window."
        },
        "verdictBreakdowns": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1VerdictBreakdown"
          },
          "description": "Faceted verdict rates per dimension requested via group_by."
        }
      }
    },
    "v1GetOutcomeTimeSeriesRequest": {
      "type": "object",
      "properties": {
        "filter": {
          "$ref": "#/definitions/v1MetricsFilter"
        },
        "scoreName": {
          "type": "string",
          "title": "e.g. \"task_completion.finished\", \"tool_quality.success_rate\""
        },
        "aggregation": {
          "type": "string",
          "title": "\"avg\", \"rate_true\", \"rate_false\", \"count\""
        },
        "granularity": {
          "type": "string",
          "title": "\"minute\", \"hour\", \"day\""
        },
        "agentId": {
          "type": "string",
          "title": "optional"
        },
        "groupBy": {
          "type": "string",
          "description": "group_by accepts: \"model\", \"provider\", \"prompt_template_id\",\n\"prompt_version\", \"tool_name\". Empty = single series."
        }
      }
    },
    "v1GetOutcomeTimeSeriesResponse": {
      "type": "object",
      "properties": {
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1MetricsTimeSeries"
          }
        }
      }
    },
