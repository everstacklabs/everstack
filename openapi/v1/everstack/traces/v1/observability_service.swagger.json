      "type": "object",
      "properties": {
        "filter": {
          "$ref": "#/definitions/v1MetricsFilter"
        },
        "userId": {
          "type": "string"
        },
        "search": {
          "type": "string",
          "title": "Search session_id"
        },
        "limit": {
          "type": "integer",
          "format": "int32"
        },
        "offset": {
          "type": "integer",
          "format": "int32"
        },
