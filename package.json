{
  "name": "everstack",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=11",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "find . -name node_modules -o -name .next -o -name .turbo -o -name dist -o -name out -type d -prune | xargs rm -rf",
    "proto": "pnpm --filter @everstack/proto -- ",
    "prepare": "husky"
  },
  "devDependencies": {
    "@everstack/eslint-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsup": "^9.0.0",
    "turbo": "^2.11.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@bufbuild/buf",
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "esbuild",
      "msw",
      "oxc-resolver",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lobehub/icons": "^6.15.0"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-musl": "1.33.0"
  }
}
