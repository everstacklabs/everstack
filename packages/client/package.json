{
  "name": "@everstack/client",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./v1": {
      "types": {
        "import": "./dist/v1.d.ts",
        "require": "./dist/v1.d.cts",
        "default": "./dist/v1.d.ts"
      },
      "import": "./dist/v1.js",
      "require": "./dist/v1.cjs"
    },
    "./v2": {
      "types": {
        "import": "./dist/v2.d.ts",
        "require": "./dist/v2.d.cts",
        "default": "./dist/v2.d.ts"
      },
      "import": "./dist/v2.js",
      "require": "./dist/v2.cjs"
    },
    "./v3alpha": {
      "types": {
        "import": "./dist/v3alpha.d.ts",
        "require": "./dist/v3alpha.d.cts",
        "default": "./dist/v3alpha.d.ts"
      },
      "import": "./dist/v3alpha.js",
      "require": "./dist/v3alpha.cjs"
    },
    "./node": {
      "types": {
        "import": "./dist/node.d.ts",
        "require": "./dist/node.d.cts",
        "default": "./dist/node.d.ts"
      },
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./web": {
      "types": {
        "import": "./dist/web.d.ts",
        "require": "./dist/web.d.cts",
        "default": "./dist/web.d.ts"
      },
      "import": "./dist/web.js",
      "require": "./dist/web.cjs"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "generate": "buf generate https://github.com/everstacklabs/everstack.git --path ./proto/everstack",
    "build": "tsup --dts",
    "test": "pnpm test:unit",
    "test:watch": "pnpm test:unit:watch",
    "test:unit": "vitest",
    "test:unit:watch": "vitest --watch",
    "dev": "tsup --watch --dts",
    "lint": "eslint \"src/**/*.ts*\"",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist && rm -rf src/proto"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protocompile": "^0.0.1",
    "@everstack/typescript-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@everstack/eslint-config": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "knip": "^6.32.3",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@connectrpc/connect-query": "^2.3.1",
    "@connectrpc/connect-web": "^2.1.2",
    "@everstack/proto": "workspace:*",
    "jose": "^6.2.10"
  }
}
